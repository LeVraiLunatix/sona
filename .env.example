# Token du bot Telegram (@BotFather)
BOT_TOKEN=

# IDs Telegram des administrateurs de départ (séparés par des virgules).
# Chargés en base au démarrage. Ce sont eux qui peuvent ensuite inviter
# d'autres utilisateurs directement depuis le bot (Paramètres > Gestion des
# accès), sans toucher à ce fichier. Liste vide = personne ne peut se connecter.
ALLOWED_USER_IDS=123456789,987654321

# Optionnel : identifiants API Spotify (Client Credentials Flow). Sans eux,
# les liens de morceaux Spotify passent par les données publiques (oEmbed et
# page du morceau), mais pas les albums ni les artistes. Spotify exige un
# abonnement Premium pour le compte propriétaire de l'app : sinon l'API
# répond 403, et Sona se rabat sur les données publiques pour les morceaux.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Chemin vers l'exécutable ffmpeg (sinon recherché dans le PATH)
FFMPEG_PATH=

# Fichier SQLite (chemin relatif au dossier du projet par défaut)
DATABASE_PATH=data/sona.db

# Dossier des sauvegardes quotidiennes de la base (7 dernières conservées).
# Chemin relatif au dossier du projet par défaut. Un disque différent de
# celui de la base est plus sûr, si le VPS en a un.
BACKUP_DIR=data/backups

# Chemin vers un fichier de cookies YouTube (format Netscape, ex: exporté par
# l'extension "Get cookies.txt LOCALLY"). Nécessaire quand YouTube bloque les
# requêtes avec "Sign in to confirm you're not a bot" — quasi systématique
# depuis une IP de datacenter (VPS), rare depuis une connexion résidentielle.
# Par défaut, Sona cherche data/cookies.txt s'il existe ; inutile de définir
# cette variable si tu places le fichier à cet emplacement.
YOUTUBE_COOKIES_FILE=
