# Token du bot Telegram (@BotFather)
BOT_TOKEN=

# IDs Telegram autorisés à utiliser le bot (séparés par des virgules).
# Bot privé : laisser une liste vide bloque tout le monde.
ALLOWED_USER_IDS=123456789,987654321

# Optionnel : identifiants API Spotify (Client Credentials Flow) pour une
# résolution plus fiable des liens open.spotify.com. Sans ces valeurs, Sona
# retombe sur l'oEmbed public de Spotify (métadonnées plus limitées).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Chemin vers l'exécutable ffmpeg (sinon recherché dans le PATH)
FFMPEG_PATH=

# Fichier SQLite (chemin relatif au dossier du projet par défaut)
DATABASE_PATH=data/sona.db
