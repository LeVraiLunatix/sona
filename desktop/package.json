{
  "name": "sona-desktop",
  "productName": "Sona",
  "version": "1.0.0",
  "description": "Sona pour Windows : ta musique sur ton PC, Sona Connect et la télécommande depuis ton téléphone.",
  "main": "src/main.js",
  "private": true,
  "author": "Sona",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/remote-server.js && node --check src/glyphs.js && node --check src/settings.js && node --check src/mini/mini.js && node --check remote/remote.js && node --check src/iphone.js && node --check src/updater.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.sona.desktop",
    "productName": "Sona",
    "copyright": "Sona",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "remote/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*",
          "!vercel.json"
        ]
      },
      {
        "from": "iphone/target/release",
        "to": ".",
        "filter": [
          "sona-iphone.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../web/icons/icon-512.png",
      "artifactName": "Sona-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sona",
      "artifactName": "Sona-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sona-Portable-${version}.${ext}"
    }
  }
}
