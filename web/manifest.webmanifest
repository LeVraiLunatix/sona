{
  "name": "Sona",
  "short_name": "Sona",
  "description": "Ta musique, tes playlists, tes paroles et tes stats.",
  "lang": "fr",
  "dir": "ltr",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Rechercher", "url": "./#/search", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bibliothèque", "url": "./#/library", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Stats", "url": "./#/stats", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Blind test", "url": "./#/blindtest", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
