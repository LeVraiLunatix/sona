# Service de comptes Sona (Rust) : à placer à côté du binaire sur le VPS, jamais dans le dépôt.
# Voir docs/AUTH_SETUP.md. Rien de tout cela n'atteint un navigateur ou une app.

# Adresse d'écoute (derrière Caddy / nginx en HTTPS).
ACCOUNTS_BIND=127.0.0.1:8100

# Postgres de ton projet Supabase, connexion serveur (rôle `postgres`, de préférence via le pooler « session »).
# Supabase > Project Settings > Database > Connection string.
DATABASE_URL=postgres://postgres:MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres

# https://xxxxxxxx.supabase.co (sans / final). Les clés publiques de signature des jetons sont lues
# sur /auth/v1/.well-known/jwks.json (nouveaux projets).
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Ancien projet à secret HMAC (HS256) seulement : Project Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=
# Clé « service role » : UNIQUEMENT pour fabriquer la session d'une connexion par clé d'accès.
SUPABASE_SERVICE_ROLE_KEY=

# Origines autorisées à appeler ce service depuis un navigateur (séparées par des virgules).
# app://sona = l'application Windows.
CORS_ORIGINS=https://www.trysona.fr,https://trysona.fr,app://sona
# Adresses de retour autorisées pour Last.fm (origines exactes, jamais de redirection libre).
ALLOWED_RETURN_URLS=https://www.trysona.fr,https://trysona.fr

# Last.fm (https://www.last.fm/api/account/create) : clé ET secret restent ici.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Facultatif : l'ancienne application Last.fm, si les anciens comptes l'utilisaient et que la clé ci-dessus est neuve.
# Leurs liaisons reprises passent par elle ; les nouvelles par la clé ci-dessus.
LASTFM_LEGACY_API_KEY=
LASTFM_LEGACY_API_SECRET=
# 32 octets aléatoires en base64 : chiffre les clés de session Last.fm.
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Secret partagé avec le serveur musique (en-tête x-sona-internal). openssl rand -hex 32
INTERNAL_API_SECRET=
# Adresse INTERNE du serveur musique (export, suppression de données, masquage de playlist, sessions).
MUSIC_INTERNAL_URL=http://127.0.0.1:8000

# Secret du hook « avant création d'utilisateur » (Auth > Hooks), de la forme v1,whsec_<base64>.
AUTH_HOOK_SECRET=

# Alertes pour l'équipe (nouveau signalement, pic d'inscriptions…) : webhook d'un salon Discord privé.
ALERTS_DISCORD_WEBHOOK=

# Passkeys : domaine du site (sans https://) et origine exacte de la page.
WEBAUTHN_RP_ID=trysona.fr
# trysona.fr redirige vers www : l'origine est celle de la page affichée.
WEBAUTHN_ORIGIN=https://www.trysona.fr

# Durée du cache de statut de compte (secondes). 5 = un ban ou une suspension s'applique en moins de 5 s
# aux sessions ouvertes ; la décision prise via ce service est appliquée à l'instant.
STATUS_CACHE_SECONDS=5

RUST_LOG=info
